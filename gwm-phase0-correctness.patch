From 246d4fcf20dbc55ade3cfe3f4d7f5f480d9a5f69 Mon Sep 17 00:00:00 2001
From: "z.ai agent" <agent@z.ai>
Date: Mon, 2 Nov 2026 17:07:30 +0000
Subject: [PATCH 3/3] Add SchemaVersion to .wsite files with forward migration

.wsite files had no format version, so any future model change would
either break old saves silently or require hand-edits. SiteProject
gains a nullable SchemaVersion: null in memory and for legacy files
(the JSON property is absent), stamped to CurrentSchemaVersion on
Save, and normalized by ProjectStorage.Migrate on Load, which gains
one arm per future version bump.
---
 src/WaterMgmt.Core/Models.cs       |  9 +++++++++
 src/WaterMgmt.Core/Storage.cs      | 30 +++++++++++++++++++++++++++---
 tests/WaterMgmt.Tests/CoreTests.cs | 18 ++++++++++++++++++
 3 files changed, 54 insertions(+), 3 deletions(-)

diff --git a/src/WaterMgmt.Core/Models.cs b/src/WaterMgmt.Core/Models.cs
index 59b5c2f..50fccfb 100644
--- a/src/WaterMgmt.Core/Models.cs
+++ b/src/WaterMgmt.Core/Models.cs
@@ -64,6 +64,15 @@ public class TakingRecord
 
 public class SiteProject
 {
+    /// <summary>Current .wsite file format version. Bump when the serialized shape
+    /// changes and add a matching arm in ProjectStorage.Migrate.</summary>
+    public const int CurrentSchemaVersion = 1;
+
+    /// <summary>File format version of this project. Null in memory and for legacy
+    /// files saved before versioning existed (the JSON property is simply absent);
+    /// ProjectStorage stamps it on Save and migrates null files to the current
+    /// version on Load.</summary>
+    public int? SchemaVersion { get; set; }
     public string SiteName { get; set; } = "New Site";
     public string? ImagePath { get; set; }
     public Permit Permit { get; set; } = new();
diff --git a/src/WaterMgmt.Core/Storage.cs b/src/WaterMgmt.Core/Storage.cs
index 03a9481..df10ff3 100644
--- a/src/WaterMgmt.Core/Storage.cs
+++ b/src/WaterMgmt.Core/Storage.cs
@@ -11,9 +11,33 @@ public static class ProjectStorage
         Converters = { new JsonStringEnumConverter() }
     };
 
-    public static void Save(SiteProject p, string path) =>
+    public static void Save(SiteProject p, string path)
+    {
+        p.SchemaVersion = SiteProject.CurrentSchemaVersion;   // always stamp the current format
         File.WriteAllText(path, JsonSerializer.Serialize(p, Opts));
+    }
+
+    public static SiteProject Load(string path)
+    {
+        var p = JsonSerializer.Deserialize<SiteProject>(File.ReadAllText(path), Opts) ?? new SiteProject();
+        return Migrate(p);
+    }
 
-    public static SiteProject Load(string path) =>
-        JsonSerializer.Deserialize<SiteProject>(File.ReadAllText(path), Opts) ?? new SiteProject();
+    /// <summary>
+    /// Forward-migrates older .wsite files to SiteProject.CurrentSchemaVersion.
+    /// Legacy files written before SchemaVersion existed deserialize with
+    /// SchemaVersion == null (the property is absent from the JSON). When bumping
+    /// the format, add a new arm per version step, oldest first.
+    /// </summary>
+    static SiteProject Migrate(SiteProject p)
+    {
+        if (p.SchemaVersion is null)
+        {
+            // v0 -> v1: SchemaVersion introduced; no data shape changed, just stamp it.
+            p.SchemaVersion = SiteProject.CurrentSchemaVersion;
+        }
+        // Future example:
+        // if (p.SchemaVersion < 2) { /* upgrade v1 data to v2 */ p.SchemaVersion = 2; }
+        return p;
+    }
 }
diff --git a/tests/WaterMgmt.Tests/CoreTests.cs b/tests/WaterMgmt.Tests/CoreTests.cs
index b702c53..a6fd941 100644
--- a/tests/WaterMgmt.Tests/CoreTests.cs
+++ b/tests/WaterMgmt.Tests/CoreTests.cs
@@ -131,6 +131,24 @@ public class CoreTests
         soon.Permit.Expires = DateTime.Today.AddDays(30);
         Assert.Contains("expires in 30 days", ReportBuilder.Html(soon, null));
     }
+
+    [Fact]
+    public void Load_FileWithoutSchemaVersion_MigratesToV1()
+    {
+        var p = Site();
+        p.Features.Add(new SiteFeature { Name = "Pit 1", Kind = FeatureKind.Pit });
+        var f = Path.GetTempFileName();
+        ProjectStorage.Save(p, f);
+        Assert.Contains("SchemaVersion", File.ReadAllText(f));     // stamped on save
+        // simulate a legacy v0 file: rename the property so it deserializes as absent
+        File.WriteAllText(f, File.ReadAllText(f).Replace("SchemaVersion", "OldSchemaVersion"));
+        var q = ProjectStorage.Load(f);
+        Assert.Equal(SiteProject.CurrentSchemaVersion, q.SchemaVersion);   // v0 file migrated
+        Assert.Equal("Pit 1", q.Features[0].Name);                 // data intact
+        // round trip: the migrated project saves as the current version
+        ProjectStorage.Save(q, f);
+        Assert.Equal(SiteProject.CurrentSchemaVersion, ProjectStorage.Load(f).SchemaVersion);
+    }
 }
 
