From 4cc99f31618aab2155efd5959940df57f4bc6161 Mon Sep 17 00:00:00 2001
From: "z.ai agent" <agent@z.ai>
Date: Mon, 2 Nov 2026 17:07:30 +0000
Subject: [PATCH 2/3] Add permit expiry notices (90/30 days, expired) to
 compliance and reports
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Permit renewals take months, but the app only flagged takings that
happened after expiry — the first signal arrived too late to act on.
ComplianceChecker.GetPermitNotices now returns a countdown:
warning at 90 days, critical at 30, expired past due (asOf injectable
for reproducible tests). The HTML report renders the notice in a
highlighted band so the renewal deadline is on every exported report.
---
 src/WaterMgmt.Core/Compliance.cs   | 28 ++++++++++++++++++++++++++++
 src/WaterMgmt.Core/Reports.cs      |  5 +++++
 tests/WaterMgmt.Tests/CoreTests.cs | 17 +++++++++++++++++
 3 files changed, 50 insertions(+)

diff --git a/src/WaterMgmt.Core/Compliance.cs b/src/WaterMgmt.Core/Compliance.cs
index ec55b4c..21fd902 100644
--- a/src/WaterMgmt.Core/Compliance.cs
+++ b/src/WaterMgmt.Core/Compliance.cs
@@ -5,6 +5,9 @@ public record Exceedance(DateTime Date, string Source, string Rule, double Actua
 public record SourceSummary(string Source, double TotalLitres, int DaysTaking, double MaxDayLitres,
     double? MaxLpm, double? LimitLpd, double? LimitLpm, int? LimitDays);
 
+/// <summary>An upcoming (or passed) permit deadline, surfaced before it becomes an exceedance.</summary>
+public record PermitNotice(string Severity, int Days, string Message);
+
 public static class ComplianceChecker
 {
     public static List<Exceedance> Check(SiteProject p, int? year = null)
@@ -43,6 +46,31 @@ public static class ComplianceChecker
     static double? ObservedLpm(TakingRecord r) =>
         r.PeakLpm ?? (r.PumpingMinutes is > 0 ? r.Litres / r.PumpingMinutes : null);
 
+    /// <summary>
+    /// Deadline warnings for the permit: expired, critical (30 days or less),
+    /// warning (90 days or less). Renewals take months, so this is surfaced
+    /// well before any taking-after-expiry exceedance can happen.
+    /// </summary>
+    public static List<PermitNotice> GetPermitNotices(SiteProject p, DateTime? asOf = null)
+    {
+        var res = new List<PermitNotice>();
+        var today = (asOf ?? DateTime.Today).Date;
+        if (p.Permit.Expires is { } exp)
+        {
+            var days = (int)(exp.Date - today).TotalDays;
+            if (days < 0)
+                res.Add(new PermitNotice("expired", days,
+                    $"Permit {p.Permit.Number} EXPIRED {-days:N0} days ago ({exp.Date:yyyy-MM-dd})."));
+            else if (days <= 30)
+                res.Add(new PermitNotice("critical", days,
+                    $"Permit {p.Permit.Number} expires in {days} days ({exp.Date:yyyy-MM-dd})."));
+            else if (days <= 90)
+                res.Add(new PermitNotice("warning", days,
+                    $"Permit {p.Permit.Number} expires in {days} days ({exp.Date:yyyy-MM-dd})."));
+        }
+        return res;
+    }
+
     public static List<SourceSummary> Summarize(SiteProject p, int? year = null)
     {
         var recs = p.Takings.Where(t => year == null || t.Date.Year == year).ToList();
diff --git a/src/WaterMgmt.Core/Reports.cs b/src/WaterMgmt.Core/Reports.cs
index 8362de2..5f090d9 100644
--- a/src/WaterMgmt.Core/Reports.cs
+++ b/src/WaterMgmt.Core/Reports.cs
@@ -17,6 +17,11 @@ public static class ReportBuilder
             "th{background:#e8eef4}td:first-child,th:first-child{text-align:left}.bad{color:#b00020;font-weight:bold}</style></head><body>");
         sb.Append($"<h1>Water Taking Summary – {E(p.SiteName)}</h1>");
         sb.Append($"<p>PTTW {E(p.Permit.Number)} · Holder: {E(p.Permit.Holder)} · Expires: {E(p.Permit.Expires?.ToString("yyyy-MM-dd"))} · Period: {(year?.ToString() ?? "all")}</p>");
+        foreach (var n in ComplianceChecker.GetPermitNotices(p))
+        {
+            var color = n.Severity is "expired" or "critical" ? "#b00020" : "#8a6d00";
+            sb.Append($"<p style='margin:8px 0;padding:6px 10px;font-weight:bold;color:{color};background:#fff8e1;border:1px solid #e0c868'>{E(n.Message)}</p>");
+        }
         sb.Append("<h2>Takings by source</h2><table><tr><th>Source</th><th>Total (L)</th><th>Days</th><th>Max day (L)</th><th>Limit L/day</th><th>Max L/min</th><th>Limit L/min</th><th>Limit days/yr</th></tr>");
         foreach (var s in sum)
             sb.Append($"<tr><td>{E(s.Source)}</td><td>{N(s.TotalLitres)}</td><td>{s.DaysTaking}</td><td>{N(s.MaxDayLitres)}</td><td>{N(s.LimitLpd)}</td><td>{N(s.MaxLpm)}</td><td>{N(s.LimitLpm)}</td><td>{s.LimitDays?.ToString() ?? "—"}</td></tr>");
diff --git a/tests/WaterMgmt.Tests/CoreTests.cs b/tests/WaterMgmt.Tests/CoreTests.cs
index 9d52815..b702c53 100644
--- a/tests/WaterMgmt.Tests/CoreTests.cs
+++ b/tests/WaterMgmt.Tests/CoreTests.cs
@@ -114,6 +114,23 @@ public class CoreTests
         Assert.Equal(120, p.Takings[0].PumpingMinutes);            // 2 h = 120 min, not 2 min
         Assert.Contains(r.Warnings, w => w.Contains("converted"));
     }
+
+    [Fact]
+    public void PermitNotices_WarnAt90_30_AndExpiry()
+    {
+        var p = Site();                                            // Expires 2026-12-31
+        Assert.Empty(ComplianceChecker.GetPermitNotices(p, new DateTime(2026, 1, 1)));
+        Assert.Contains(ComplianceChecker.GetPermitNotices(p, new DateTime(2026, 10, 2)),
+            n => n.Severity == "warning" && n.Days == 90);
+        Assert.Contains(ComplianceChecker.GetPermitNotices(p, new DateTime(2026, 12, 1)),
+            n => n.Severity == "critical" && n.Days == 30);
+        Assert.Contains(ComplianceChecker.GetPermitNotices(p, new DateTime(2027, 1, 10)),
+            n => n.Severity == "expired" && n.Days == -10);
+        // the HTML report surfaces notices (30 days out -> deterministic message)
+        var soon = Site();
+        soon.Permit.Expires = DateTime.Today.AddDays(30);
+        Assert.Contains("expires in 30 days", ReportBuilder.Html(soon, null));
+    }
 }
 
